# Set default behavior for line endings
* text=auto

# Declare text files
*.rb text
*.py text
*.sh text eol=lf
*.md text
*.json text
*.yaml text
*.yml text
*.js text
*.html text
*.css text

# Declare binary files (Git standard, no LFS)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.mov binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
