
set export

# Should get them from envrc...
export PROJECT_ID := 'dungemoji'
GCP_REGION := 'fake-antarctica-east-1'

# Lists all targets
[group('default')]
list:
    @yellow "[justfile] PROJECT_ID=$PROJECT_ID"
    @yellow "[justfile] GCP_REGION=$GCP_REGION"
    @just -l


# Creates '.firebase.rc' with proper project_id
init:
    if [ -f .firebaserc ] ; then echo inutile ; exit 2 ; fi
    firebase init

# .firebase.rc

deploy:
    echo on derek: node_modules/.bin/firebase deploy
    firebase deploy

push: deploy

emulate:
  firebase emulators:start

# Smoke test HTML, Mobility Unit Tests, L5 Epic Metal MP3, Veo 3.1 Death MP4s & embedded NanoBanana assets
test:
  @VER=$(cat VERSION | tr -d '[:space:]') && grep -q "DUNGEMOJI v$VER" public/index.html && echo "✅ public/index.html v$VER verified!"
  @grep -q "runMobilityUnitTests" public/index.html && echo "✅ Mobility, Secret Room & 3D Raycast Unit Test Suite embedded!"
  @grep -q "carveSecretRoomInNegativeSpace" public/index.html && echo "✅ Negative-Space Secret Rooms & Paladin Spells verified!"
  @grep -q "quit-modal" public/index.html && echo "✅ ESC Quit/Save Confirmation Modal verified!"
  @test -f public/audio/epic_metal_l5.mp3 && echo "✅ Level 5 Medieval Epic Metal MP3 verified!"
  @test -f public/audio/death_default.mp4 && test -f public/audio/death_eyes.mp4 && test -f public/audio/death_zombie.mp4 && echo "✅ All 3 Veo 3.1 Death Cutscene MP4s (Dragon, Eyes, Zombie) verified!"
  @grep -q "pupurabbu" public/index.html && echo "✅ Il Mitico Pupurabbu (2x2 IF Bear) & 27 NanoBanana sprites embedded!"

# Open local or deployed game
open:
  open "https://$PROJECT_ID.web.app"

